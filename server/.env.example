# Digital Khata Server Configuration
# Copy this file to .env and fill in your values

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# AI Provider — OpenRouter (recommended)
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_SITE_NAME=Digital Khata
OPENROUTER_MODEL=openai/gpt-4o-mini

# AI Provider — Generic OpenAI-compatible (fallback if OPENROUTER_API_KEY is empty)
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# WhatsApp Business API (optional)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Database (for production — replace in-memory store)
DATABASE_URL=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
