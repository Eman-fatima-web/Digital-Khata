{
  "framework": "vite",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/[[...path]]"
    },
    {
      "source": "/health(.*)",
      "destination": "/api/[[...path]]"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "VERCEL": "1"
  },
  "crons": [
    {
      "path": "/api/jobs/run?job=dailySummary",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/jobs/run?job=weeklySummary",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/jobs/run?job=monthlySummary",
      "schedule": "0 9 1 * *"
    },
    {
      "path": "/api/jobs/run?job=overdueReminders",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/jobs/run?job=syncQueueCleanup",
      "schedule": "0 3 * * 0"
    }
  ]
}
